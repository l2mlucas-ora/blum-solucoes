---
// Assistente guiado (sem IA). Roteiros em src/data/chat/{pt,en,es}.ts, motor em src/scripts/chat.ts.
import { idiomaDe } from "../i18n/routes";
import { ui } from "../i18n/ui";
const t = ui[idiomaDe(Astro.url.pathname)].chat;
---
<div class="chat" id="chat" data-open="false">
  <div class="chat-teaser" id="chat-teaser" hidden>
    <span>{t.teaser}</span>
    <button type="button" aria-label={t.dispensar}>×</button>
  </div>
  <button class="chat-fab" id="chat-fab" type="button" aria-expanded="false" aria-controls="chat-panel" aria-label={t.botao}>
    <svg class="i-open" viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5v-9Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8.5 9.5h7M8.5 12.5h4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
    <svg class="i-close" viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
    <span class="chat-fab-txt">{t.botao}</span>
  </button>
  <section class="chat-panel" id="chat-panel" role="dialog" aria-label={t.dialogo} hidden>
    <header class="chat-head">
      <span class="chat-av" aria-hidden="true"><img src="/img/logo-simbolo.svg" alt="" width="20" height="23"></span>
      <div><b>{t.titulo}</b><span>{t.sub}</span></div>
      <button type="button" class="chat-ic" id="chat-reset" aria-label={t.recomecar} title={t.recomecar}>
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true"><path d="M4 10a6 6 0 1 0 1.8-4.3M4 3.5v3h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" class="chat-ic" id="chat-close" aria-label={t.fechar}>
        <svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </header>
    <div class="chat-log" id="chat-log" role="log" aria-live="polite"></div>
    <div class="chat-ctl">
      <div class="chat-opts" id="chat-opts"></div>
      <form class="chat-form" id="chat-form" hidden>
        <label id="chat-input-lbl" for="chat-input" class="sr-only">{t.resposta}</label>
        <input id="chat-input" required maxlength="120">
        <button type="submit" class="btn btn-primary btn-sm">{t.enviar}</button>
      </form>
    </div>
  </section>
</div>
<script>
  import "../scripts/chat.ts";
</script>

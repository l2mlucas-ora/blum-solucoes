    regEye: "Service area", regH: "Garopaba and surroundings", regLead: "We're local: we quickly cover the towns and beaches below. For other nearby towns, just ask.", mapaAlt: "Map of the areas served by Blum Soluções",
    faqEye: "FAQ", faqH: "Questions we hear the most",
    ctEye: "Contact", ctH: "Let's solve it together", ctLead: "Send a message through the form, use the assistant or message us directly on WhatsApp — in English.", ctWa: "Message us on WhatsApp", regiaoUf: "and surroundings",
    f: { nome: "Name", tel: "WhatsApp (with country code)", telPh: "+1 555 123 4567", serv: "Service", sel: "Select", outro: "Other", cid: "Town / beach", msg: "What do you need?", msgPh: "E.g. install 4 cameras at my vacation home", site: "Website", consent: "I agree that Blum Soluções may contact me and accept the", pol: "Privacy Policy", enviar: "Send message" },
    ctaH: "Own a vacation home? Get it ready before summer.", ctaP: "Electrical check, cameras you can watch from abroad and smart locks with a code for each guest.", ctaBtn: "See how it works", ctaWa: "Hi! I'd like to get my vacation home ready for summer. (I speak English)",
  },
  es: {
    title: "Blum Soluções — Electricidad y seguridad electrónica en Garopaba",
    desc: "Electricista en Garopaba que habla español: cámaras de seguridad, cerraduras digitales, alarmas, iluminación y cargadores de auto eléctrico. Más de 10 años de experiencia. Presupuesto rápido por WhatsApp.",
    eyebrow: "Garopaba y región · Santa Catarina, Brasil",
    h1a: "Electricidad y seguridad electrónica", h1b: "bien hechas.",
    lead: "Instalaciones eléctricas, cámaras que ves desde el celular, cerraduras digitales, alarmas e iluminación — para casas, casas de temporada, posadas, tiendas e iglesias. Más de 10 años brindando la mejor experiencia a nuestros clientes. Hablamos español.",
    orc: "Presupuesto rápido", visita: "Agendar visita técnica",
    trust: [`+${anos} años de experiencia`, "Normas NBR 5410 y Celesc", "Atención en español e inglés"],
    badgeT: "Un antes y después real", badge: "Iluminación completa de una iglesia en Garopaba",
    servEye: "Servicios", servH: "Electricidad y seguridad con un solo equipo", servLead: "Del tablero eléctrico a la cámara en tu celular: proyecto, instalación y mantenimiento sin coordinar varios proveedores.",
    mais: "Ver más", naoSabeH: "¿No sabes por dónde empezar?", naoSabe: "Cuéntale al asistente lo que necesitas: te indica el servicio y hace un presupuesto estimado.", falar: "Hablar con el asistente",
    stats: [[`+${anos}`, "años de experiencia"], ["5", "especialidades en un equipo"], [String(site.regiao.length), "ciudades y playas atendidas"], ["3", "idiomas: portugués, español e inglés"]],
    passosEye: "Cómo funciona", passosH: "Del primer contacto a la obra terminada",
    passos: [["Cuéntanos qué necesitas", "Por el asistente del sitio o por WhatsApp. Las fotos ayudan mucho."], ["Visita técnica", "Vamos al lugar, medimos e indicamos la mejor solución para tu caso."], ["Presupuesto claro", "Material, mano de obra y plazo por escrito. Sin sorpresas."], ["Ejecución y garantía", "Instalación prolija, todo probado y explicación de cómo usarlo."]],
    obrasEye: "Trabajos recientes", obrasH: "Nuestro trabajo en el día a día", obrasLead: "Mira más trabajos en Instagram",
    antes: "Antes", depois: "Después", adH: "Una iglesia en Garopaba: de la obra en bruto a una luz que acoge", adP: "Proyecto e instalación eléctrica completa, spots empotrados en el techo de madera, tiras LED en los laterales y destaque en la pared de piedra del altar.",
    obras: [
      ["/img/obras/corredor-led.webp", "Perfil LED empotrado en el techo de un pasillo", "Perfil LED empotrado"],
      ["/img/obras/loja-trilho.webp", "Tienda de colchones con rieles de spots y LED", "Iluminación comercial con rieles"],
      ["/img/obras/sanca-led.webp", "Garganta con iluminación indirecta LED", "Garganta con luz indirecta"],
      ["/img/obras/eletroposto.webp", "Electrolinera con cargador de auto eléctrico", "Cargador de auto eléctrico"],
      ["/img/obras/camera-pergolado.webp", "Cámara de seguridad Intelbras en pérgola", "Cámaras Intelbras"],
      ["/img/ig/post6.jpg", "Cerradura digital en puerta de madera", "Cerradura digital"],
      ["/img/obras/camera-fachada.webp", "Cámara de seguridad en fachada con caja de paso", "CCTV con buena terminación"],
      ["/img/ig/post5.jpg", "Balizas en área exterior", "Balizas exteriores"],

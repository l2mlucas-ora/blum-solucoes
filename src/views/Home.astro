---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import FaqList from "../components/FaqList.astro";
import { servicosEm } from "../data/servicos";
import { faqGeral } from "../data/faq";
import { faqLd } from "../data/seo";
import { site, whatsapp, waLink, waPadrao, anosDeMercado } from "../data/site";
import { r, type Lang } from "../i18n/routes";

interface Props { lang: Lang }
const { lang } = Astro.props;
const anos = anosDeMercado - 1;
const servicos = servicosEm(lang);
const tel = lang === "pt" ? whatsapp.exibicao : whatsapp.internacional;

const T = {
  pt: {
    title: "Blum Soluções — Elétrica e segurança eletrônica em Garopaba e região",

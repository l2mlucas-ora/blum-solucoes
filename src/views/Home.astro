    depEye: "Clientes", depH: "Quien nos contrata, nos recomienda",
    deps: [["Trabajo prolijo de principio a fin. Explicaron todo y dejaron la obra limpia.", "Cliente residencial · Garopaba"], ["Instalaron las cámaras de la posada en un día y configuraron la app en el celular de todo el equipo.", "Posada · Praia do Rosa"], ["La cerradura digital resolvió la entrega de llaves de mi Airbnb mientras estoy en Argentina. Respuesta rápida por WhatsApp.", "Anfitrión · Ferrugem"]],
    regEye: "Zona de atención", regH: "Garopaba y región", regLead: "Estamos cerca: atendemos con rapidez las ciudades y playas de abajo. Para otras ciudades cercanas, consulta.", mapaAlt: "Mapa con las zonas atendidas por Blum Soluções",
    faqEye: "Preguntas frecuentes", faqH: "Lo que más nos preguntan",
    ctEye: "Contacto", ctH: "Resolvámoslo juntos", ctLead: "Envía un mensaje por el formulario, usa el asistente o escríbenos directo por WhatsApp, en español.", ctWa: "Escribir por WhatsApp", regiaoUf: "y región",
    f: { nome: "Nombre", tel: "WhatsApp (con código de país)", telPh: "+54 9 11 1234-5678", serv: "Servicio", sel: "Seleccionar", outro: "Otro", cid: "Ciudad / playa", msg: "¿Qué necesitas?", msgPh: "Ej.: instalar 4 cámaras en mi casa de temporada", site: "Sitio", consent: "Acepto que Blum Soluções me contacte y estoy de acuerdo con la", pol: "Política de Privacidad", enviar: "Enviar mensaje" },
    ctaH: "¿Tienes casa de temporada? Déjala lista antes del verano.", ctaP: "Revisión eléctrica, cámaras que ves desde tu país y cerradura digital con una clave para cada huésped.", ctaBtn: "Ver cómo funciona", ctaWa: "¡Hola! Quiero preparar mi casa de temporada para el verano. (Hablo español)",
  },
}[lang];

// PENDENTE: depoimentos reais com autorização (destaque "Feedbacks" do Instagram).
---
<Base title={T.title} description={T.desc} jsonld={[faqLd(faqGeral[lang])]} image="/img/og-blum.jpg">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-txt">
        <span class="eyebrow">{T.eyebrow}</span>
        <h1>{T.h1a} <span class="grad-text">{T.h1b}</span></h1>
        <p class="lead">{T.lead}</p>
        <div class="hero-cta">
          <button type="button" class="btn btn-primary btn-lg" data-chat-open="inicio"><Icon name="chat" size={20} />{T.orc}</button>
          <button type="button" class="btn btn-ghost btn-lg" data-chat-open="vis_servico"><Icon name="agenda" size={20} />{T.visita}</button>
        </div>
        <ul class="hero-trust">
          <li><Icon name="medalha" size={18} />{T.trust[0]}</li>
          <li><Icon name="check" size={18} />{T.trust[1]}</li>
          <li><Icon name={lang === "pt" ? "whats" : "globo"} size={18} />{T.trust[2]}</li>
        </ul>
      </div>
      <div class="hero-vis">
        <img src="/img/obras/igreja-depois.webp" alt={T.badge} width="1136" height="1200" fetchpriority="high">
        <div class="hero-badge"><span class="dot" aria-hidden="true"></span><span><b>{T.badgeT}</b>{T.badge}</span></div>
      </div>
    </div>
  </section>

  <section class="sec sec-alt" id="servicos">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">{T.servEye}</span>
        <h2>{T.servH}</h2>
        <p class="lead">{T.servLead}</p>
      </div>
      <div class="cards">
        {servicos.map((s) => (
          <a class="card reveal" href={s.href}>
            <span class="card-ic"><Icon name={s.icone} size={24} /></span>
            <h3>{s.nome}</h3>
            <p>{s.curto}</p>
            <span class="card-more">{T.mais} <Icon name="seta" size={16} /></span>
          </a>
        ))}
        <button type="button" class="card card-cta reveal" data-chat-open="inicio">
          <span class="card-ic"><Icon name="chat" size={24} /></span>
          <h3>{T.naoSabeH}</h3>
          <p>{T.naoSabe}</p>
          <span class="card-more">{T.falar} <Icon name="seta" size={16} /></span>
        </button>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <ul class="stats reveal">
        {T.stats.map(([n, l]) => <li><b class="grad-text">{n}</b><span>{l}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">{T.passosEye}</span>
        <h2>{T.passosH}</h2>
      </div>
      <ol class="steps">
        {T.passos.map(([h, p]) => <li class="reveal"><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="sec" id="obras">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">{T.obrasEye}</span>
        <h2>{T.obrasH}</h2>
        <p class="lead">{T.obrasLead} <a class="grad-text" href={site.redes.instagram} target="_blank" rel="noopener">{site.redes.instagramUser}</a>.</p>
      </div>
      <div class="antes-depois reveal">
        <figure><img src="/img/obras/igreja-antes.webp" alt={`${T.antes}: ${T.adH}`} width="1125" height="1200" loading="lazy"><figcaption>{T.antes}</figcaption></figure>
        <figure><img src="/img/obras/igreja-depois.webp" alt={`${T.depois}: ${T.adH}`} width="1136" height="1200" loading="lazy"><figcaption>{T.depois}</figcaption></figure>
        <div class="ad-txt"><h3>{T.adH}</h3><p>{T.adP}</p></div>
      </div>
      <div class="gal">
        {T.obras.map(([src, alt, cap]) => (
          <figure class="reveal"><img src={src} alt={alt} width="600" height="800" loading="lazy"><figcaption>{cap}</figcaption></figure>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">{T.depEye}</span>
        <h2>{T.depH}</h2>
      </div>
      <div class="depo">
        {T.deps.map(([txt, quem]) => (
          <blockquote class="reveal"><span class="stars" aria-hidden="true">★★★★★</span><p>“{txt}”</p><footer>{quem}</footer></blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="regiao">
    <div class="wrap regiao">
      <div class="sec-head reveal" style="margin-bottom:0">
        <span class="eyebrow">{T.regEye}</span>
        <h2>{T.regH}</h2>
        <p class="lead">{T.regLead}</p>
        <ul class="chips">
          {site.regiao.map((c) => <li><Icon name="pin" size={16} />{c}</li>)}
        </ul>
      </div>
      <div class="mapa-card reveal">
        <img src="/img/ig/post3.jpg" alt={T.mapaAlt} width="640" height="640" loading="lazy">
      </div>
    </div>
  </section>

  <section class="sec sec-alt" id="duvidas">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">{T.faqEye}</span>
        <h2>{T.faqH}</h2>
      </div>
      <FaqList items={faqGeral[lang]} />
    </div>
  </section>

  <section class="sec" id="contato">
    <div class="wrap contato">
      <div class="contato-lado reveal">
        <span class="eyebrow">{T.ctEye}</span>
        <h2>{T.ctH}</h2>
        <p class="lead">{T.ctLead}</p>
        <ul class="contato-lista">
          <li><Icon name="whats" size={20} /><a href={waLink(waPadrao[lang])} target="_blank" rel="noopener">{tel}</a></li>
          <li><Icon name="insta" size={20} /><a href={site.redes.instagram} target="_blank" rel="noopener">{site.redes.instagramUser}</a></li>
          <li><Icon name="relogio" size={20} />{site.horario.texto[lang]}</li>
          <li><Icon name="pin" size={20} />{site.endereco.cidade} {T.regiaoUf} · {site.endereco.uf}</li>
        </ul>
        <a class="btn btn-wa" href={waLink(waPadrao[lang])} target="_blank" rel="noopener" style="align-self:flex-start"><Icon name="whats" size={20} />{T.ctWa}</a>
      </div>
      <form class="form reveal" id="form-contato" data-origem="contato" novalidate>
        <div class="field"><label for="c-nome">{T.f.nome}</label><input id="c-nome" name="nome" required autocomplete="name" minlength="2"></div>
        <div class="field"><label for="c-tel">{T.f.tel}</label><input id="c-tel" name="telefone" type="tel" required autocomplete="tel" placeholder={T.f.telPh} pattern="(.*\d){10,}.*"></div>
        <div class="field"><label for="c-serv">{T.f.serv}</label>
          <select id="c-serv" name="Serviço">
            <option value="">{T.f.sel}</option>
            {servicos.map((s) => <option>{s.nome}</option>)}
            <option>{T.f.outro}</option>
          </select>
        </div>
        <div class="field"><label for="c-cid">{T.f.cid}</label><input id="c-cid" name="Cidade" list="c-cidades"><datalist id="c-cidades">{site.regiao.map((c) => <option value={c} />)}</datalist></div>
        <div class="field full"><label for="c-msg">{T.f.msg}</label><textarea id="c-msg" name="mensagem" required placeholder={T.f.msgPh}></textarea></div>
        <div class="hp" aria-hidden="true"><label for="c-web">{T.f.site}</label><input id="c-web" name="website" tabindex="-1" autocomplete="off"></div>
        <label class="check full"><input type="checkbox" name="consentimento" value="sim" required> <span>{T.f.consent} <a href={r("privacidade", lang)} target="_blank">{T.f.pol}</a>.</span></label>
        <div class="full" style="display:flex;flex-wrap:wrap;gap:14px;align-items:center">
          <button type="submit" class="btn btn-primary">{T.f.enviar}</button>
          <p class="form-msg" id="form-contato-msg" role="status"></p>
        </div>
      </form>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="cta-band reveal">
        <div>
          <h2>{T.ctaH}</h2>
          <p>{T.ctaP}</p>
        </div>
        <div class="cta-band-act">
          <a class="btn btn-primary btn-lg" href={r("temporada", lang)}>{T.ctaBtn}</a>
          <a class="btn btn-ghost btn-lg" href={waLink(T.ctaWa)} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Base>

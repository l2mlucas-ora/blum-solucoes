  en: {
    title: "Blum Soluções — Electrician and security systems in Garopaba, Brazil",
    desc: "English-speaking electrician in Garopaba, Brazil: security cameras, smart locks, alarms, lighting and EV chargers. Over 10 years of experience. Quick quotes on WhatsApp.",
    eyebrow: "Garopaba area · Santa Catarina, Brazil",
    h1a: "Electrical and security systems", h1b: "done right.",

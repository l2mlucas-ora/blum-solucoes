---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Credenciais from "../components/Credenciais.astro";
import { site, waLink, waPadrao } from "../data/site";
import { foco } from "../data/fotos";
import { r, type Lang } from "../i18n/routes";

interface Props { lang: Lang }
const { lang } = Astro.props;
const T = {
  pt: {
    title: "Sobre a Blum Soluções", desc: "Conheça a Blum Soluções: mais de 10 anos em elétrica e segurança eletrônica em Garopaba e região, com atendimento próximo, organização e acabamento caprichado.",
    inicio: "Início", crumb: "Sobre", eyebrow: "Sobre nós", h1a: "Uma empresa local, com", h1b: "cuidado de dono.",
    p1: "À frente da Blum está Fernando Blum, técnico em eletrônica. A empresa nasceu em Garopaba para resolver elétrica e segurança eletrônica com seriedade: chegar no horário, explicar o que vai ser feito, trabalhar com organização e entregar a obra limpa.",
    p2: "Há mais de 10 anos atendemos casas, casas de temporada, pousadas, lojas, igrejas, condomínios e comércios da região — e boa parte dos novos clientes chega por indicação. Atendemos também em inglês e espanhol.",
    falar: "Falar com a gente", alt: "Fernando Blum, responsável técnico da Blum Soluções",
    comoEye: "Como trabalhamos", comoH: "O que você pode esperar",
    cards: [["radar", "Tecnologia atual", "Câmeras, alarmes com inteligência artificial e automação de última geração, escolhidos para cada caso."], ["ferramenta", "Organização", "Ferramentas limpas, carro organizado e obra entregue sem bagunça — como você vê no nosso Instagram."], ["chat", "Conversa clara", "Orçamento por escrito, explicação do que foi feito e de como usar cada sistema — em português, inglês ou espanhol."], ["medalha", "Garantia", "Garantia da mão de obra e suporte depois da instalação pelo WhatsApp."]],
    atendemos: "Atendemos", regiao: "e região", agendar: "Agendar visita", van: "Equipe Blum a caminho de mais uma obra", vanAlt: "Van da Blum Soluções em frente a uma obra",
  },
  en: {
    title: "About Blum Soluções", desc: "Meet Blum Soluções: over 10 years of electrical and security work in Garopaba, Brazil — local, organized, careful finishing, and English-speaking.",
    inicio: "Home", crumb: "About", eyebrow: "About us", h1a: "A local company that works", h1b: "like it's our own home.",
    p1: "Blum is led by Fernando Blum, an electronics technician. The company was born in Garopaba to deliver electrical and security work seriously: show up on time, explain what will be done, work tidily and leave the place clean.",
    p2: "For over 10 years we've served homes, vacation rentals, guesthouses, shops, churches, condos and businesses in the area — and many new clients come by referral. We speak English and Spanish, and many clients are foreign homeowners.",
    falar: "Talk to us", alt: "Fernando Blum, technical lead at Blum Soluções",
    comoEye: "How we work", comoH: "What you can expect",
    cards: [["radar", "Up-to-date technology", "Cameras, AI-powered alarms and the latest automation, chosen for each case."], ["ferramenta", "Tidiness", "Clean tools, an organized van and a job left spotless — as you can see on our Instagram."], ["chat", "Clear communication", "Written quotes and a walkthrough of what was done and how to use each system — in English, Spanish or Portuguese."], ["medalha", "Warranty", "Guaranteed labor and support after installation on WhatsApp."]],
    atendemos: "We cover", regiao: "and surroundings", agendar: "Book a visit", van: "The Blum team on the way to another job", vanAlt: "Blum Soluções van in front of a job site",
  },
  es: {
    title: "Sobre Blum Soluções", desc: "Conoce Blum Soluções: más de 10 años en electricidad y seguridad electrónica en Garopaba y región — atención cercana, prolijidad y buena terminación, en español.",
    inicio: "Inicio", crumb: "Nosotros", eyebrow: "Sobre nosotros", h1a: "Una empresa local, con", h1b: "cuidado de dueño.",
    p1: "Al frente de Blum está Fernando Blum, técnico en electrónica. La empresa nació en Garopaba para resolver electricidad y seguridad electrónica con seriedad: llegar a horario, explicar lo que se va a hacer, trabajar con orden y entregar la obra limpia.",
    p2: "Hace más de 10 años atendemos casas, casas de temporada, posadas, tiendas, iglesias, condominios y comercios de la región — y muchos clientes nuevos llegan por recomendación. Hablamos español e inglés, y muchos clientes son propietarios extranjeros.",
    falar: "Hablar con nosotros", alt: "Fernando Blum, responsable técnico de Blum Soluções",
    comoEye: "Cómo trabajamos", comoH: "Qué puedes esperar",
    cards: [["radar", "Tecnología actual", "Cámaras, alarmas con inteligencia artificial y automatización de última generación, elegidas para cada caso."], ["ferramenta", "Orden", "Herramientas limpias, vehículo organizado y obra entregada sin desorden — como ves en nuestro Instagram."], ["chat", "Comunicación clara", "Presupuesto por escrito y explicación de lo que se hizo y de cómo usar cada sistema — en español, inglés o portugués."], ["medalha", "Garantía", "Garantía de la mano de obra y soporte después de la instalación por WhatsApp."]],
    atendemos: "Atendemos", regiao: "y región", agendar: "Agendar visita", van: "El equipo Blum camino a otra obra", vanAlt: "Camioneta de Blum Soluções frente a una obra",
  },
}[lang];
---
<Base title={T.title} description={T.desc} crumbs={[{ name: T.crumb, href: r("sobre", lang) }]}>
  <section class="svc-hero">
    <div class="wrap">
      <ol class="crumbs"><li><a href={r("home", lang)}>{T.inicio}</a></li><li aria-current="page">{T.crumb}</li></ol>
      <div class="svc-grid">
        <div class="hero-txt">
          <span class="eyebrow">{T.eyebrow}</span>
          <h1>{T.h1a} <span class="grad-text">{T.h1b}</span></h1>
          <p class="lead">{T.p1}</p>
          <p class="lead">{T.p2}</p>
          <div class="hero-cta">
            <a class="btn btn-primary btn-lg" href={waLink(waPadrao[lang])} target="_blank" rel="noopener"><Icon name="whats" size={20} />{T.falar}</a>
          </div>
        </div>
        <div class="svc-vis svc-retrato"><img src="/img/obras/responsavel.webp" alt={T.alt} width="640" height="720" style={foco("/img/obras/responsavel.webp")}></div>
      </div>
    </div>
  </section>
  <section class="sec" style="padding-top:0">
    <div class="wrap"><Credenciais lang={lang} /></div>
  </section>
  <section class="sec sec-alt">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow">{T.comoEye}</span><h2>{T.comoH}</h2></div>
      <figure class="sobre-van reveal"><img src="/img/obras/van-blum.webp" alt={T.vanAlt} width="960" height="1280" loading="lazy" style={foco("/img/obras/van-blum.webp")}><figcaption>{T.van}</figcaption></figure>
      <div class="cards">
        {T.cards.map(([ic, h, p]) => <div class="card reveal"><span class="card-ic"><Icon name={ic} size={24} /></span><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <div class="cta-band reveal">
        <div><h2>{T.atendemos} {site.endereco.cidade} {T.regiao}</h2><p>{site.regiao.join(" · ")}</p></div>
        <div class="cta-band-act"><button type="button" class="btn btn-primary btn-lg" data-chat-open="vis_servico">{T.agendar}</button></div>
      </div>
    </div>
  </section>
</Base>

---
import Servico from "../../views/Servico.astro";
import { servicoSlug } from "../../i18n/routes";

export function getStaticPaths() {
  return Object.entries(servicoSlug).map(([id, s]) => ({ params: { slug: s.pt }, props: { id } }));
}
const { id } = Astro.props;
---
<Servico id={id} lang="pt" />

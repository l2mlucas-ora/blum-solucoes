---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/manrope";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.astro";
import Consent from "../components/Consent.astro";
import { site, abs } from "../data/site";
import { organizationLd, breadcrumbLd, type Crumb } from "../data/seo";
import { alternativas, htmlLang, ogLocale, idiomaDe, rotas, LANGS, type Lang } from "../i18n/routes";
import { ui } from "../i18n/ui";

interface Props {
  /** Título da página (sem o sufixo da marca). */
  title: string;
  description: string;
  /** Trilha para BreadcrumbList; a home não passa. */
  crumbs?: Crumb[];
  /** JSON-LD extra (FAQPage, Service...). */
  jsonld?: object[];
  /** Nó inicial do assistente nesta página. */
  chat?: string;
  image?: string;
  noindex?: boolean;
  /** false = sem cabeçalho e rodapé (link da bio). */
  chrome?: boolean;
  /** Atraso (ms) do convite do assistente. */
  teaser?: number;
}

const lang: Lang = idiomaDe(Astro.url.pathname);
const { title, description, crumbs, jsonld = [], chat = "inicio", image = "/img/og-blum.jpg", noindex = false, chrome = true, teaser } = Astro.props;
const canonical = abs(Astro.url.pathname);
const ehHome = Astro.url.pathname === rotas.home[lang];
const fullTitle = ehHome ? title : `${title} | Blum Soluções`;
const ld = [organizationLd(lang), ...(crumbs ? [breadcrumbLd(crumbs, lang)] : []), ...jsonld];
const alt = noindex ? null : alternativas(Astro.url.pathname);
const ga = import.meta.env.PUBLIC_GA_ID;
const turnstile = import.meta.env.PUBLIC_TURNSTILE_SITEKEY;
// Prévia (GitHub Pages): não indexa e não tem /api/lead — o assistente e o formulário vão direto ao WhatsApp.
const previa = import.meta.env.PUBLIC_PREVIA === "1";
---
<!doctype html>
<html lang={htmlLang[lang]}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
{noindex || previa ? <meta name="robots" content={previa ? "noindex, nofollow" : "noindex, follow"}> : <link rel="canonical" href={canonical}>}
{previa && <meta name="lead-off" content="1">}
{alt && LANGS.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(alt[l])}>)}
{alt && <link rel="alternate" hreflang="x-default" href={abs(alt.pt)}>}
<meta name="theme-color" content="#0B1012" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#F4F7F7" media="(prefers-color-scheme: light)">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/img/logo.png">
<meta property="og:type" content="website">
<meta property="og:locale" content={ogLocale[lang]}>
{LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]}>)}
<meta property="og:site_name" content="Blum Soluções">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={abs(image)}>
<meta name="twitter:card" content="summary_large_image">
<meta name="geo.region" content={site.endereco.regiaoIso}>
<meta name="geo.placename" content={site.endereco.cidade}>
<script is:inline>
// Sem zoom por pinça (como na Target). iOS antigo ignora touch-action: bloqueia o gesto direto.
document.addEventListener("gesturestart",function(e){e.preventDefault()},{passive:false});
try{var t=localStorage.getItem("blum-theme");
if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t);}catch(e){}
</script>
{ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
{ga && <meta name="ga-id" content={ga}>}
{turnstile && <meta name="turnstile" content={turnstile}>}
</head>
<body data-chat={chat} data-teaser={teaser} class={chrome ? undefined : "sem-chrome"}>
<a class="skip" href="#conteudo">{ui[lang].skip}</a>
{chrome && <Header />}
<main id="conteudo">
  <slot />
</main>
{chrome && <Footer />}
<ChatWidget />
<Consent />
<script>
  import "../scripts/site.ts";
</script>
</body>
</html>
